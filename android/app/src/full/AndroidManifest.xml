<?xml version="1.0" encoding="utf-8"?>
<!-- Only in the "full" add-on: the floating bubble (an accessibility service). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- The floating bubble. It reads the screen only when you tap it. -->
        <service
            android:name=".BubbleService"
            android:exported="true"
            android:label="ZivugBase bubble"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/bubble_service" />
        </service>
    </application>
</manifest>
