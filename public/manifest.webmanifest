{
  "name": "ZivugBase",
  "short_name": "ZivugBase",
  "description": "A private shidduch organizer. Everything stays on your phone.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f6f5f2",
  "theme_color": "#2f5d7c",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Speak", "short_name": "Speak", "description": "Say what you heard", "url": "./#/capture/speak", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Paste", "short_name": "Paste", "description": "Add what you copied", "url": "./#/capture/paste", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Inbox", "short_name": "Inbox", "description": "File what came in", "url": "./#/inbox", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        { "name": "files", "accept": ["image/*", "application/pdf", "audio/*", "text/plain", "text/vcard", "text/x-vcard", ".vcf", "application/zip", ".zip", ".txt"] }
      ]
    }
  }
}
